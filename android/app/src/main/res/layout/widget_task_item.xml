<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Checkbox tap target -->
    <FrameLayout
        android:id="@+id/task_checkbox_container"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:clickable="true"
        android:focusable="true">

        <!-- The visible checkbox circle icon -->
        <ImageView
            android:id="@+id/task_checkbox_img"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_checkbox_circle"
            android:tint="@color/widget_text_color"
            android:contentDescription="Complete task" />
    </FrameLayout>

    <!-- Task title text -->
    <TextView
        android:id="@+id/task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:textColor="@color/widget_text_color"
        android:textSize="16sp"
        android:ellipsize="end"
        android:maxLines="1" />

</LinearLayout>
