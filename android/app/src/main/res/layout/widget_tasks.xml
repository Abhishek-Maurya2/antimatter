<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header containing Category Selector (Left) and Add Task Button (Right) -->
    <RelativeLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="12dp">

        <!-- Category selector (cycles on click) -->
        <LinearLayout
            android:id="@+id/widget_category_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/widget_category_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Temp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_color" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/widget_ic_drop_down"
                android:tint="@color/widget_text_color"
                android:contentDescription="Select Category" />
        </LinearLayout>

        <!-- Add Task Button (+ button) -->
        <FrameLayout
            android:id="@+id/widget_add_button"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_add_button_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_add"
                android:contentDescription="Add Task" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Scrollable list of tasks -->
    <ListView
        android:id="@+id/widget_task_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_header"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp" />

    <!-- Empty state message -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No active tasks!"
        android:textColor="@color/widget_empty_text_color"
        android:textSize="14sp"
        android:visibility="gone" />

</RelativeLayout>
